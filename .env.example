# The cottage defaults to the Blender export at /models/cozy_room.glb.
# Point this at another .glb in public/models/ to swap it, or leave it
# empty (VITE_COTTAGE_MODEL=) to use the procedural cottage.
# VITE_COTTAGE_MODEL=/models/cozy_room.glb
# VITE_COTTAGE_SCALE=1

# Optional: swap the procedural resident for a downloaded glTF character.
# TURN is degrees (imported characters usually face away from the desk),
# LIFT is measured from the chair seat -- use -0.49 to stand one on the floor.
# VITE_PERSON_MODEL=/models/person.glb
# VITE_PERSON_SCALE=1
# VITE_PERSON_TURN=180
# VITE_PERSON_LIFT=0
